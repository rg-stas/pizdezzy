---
import PrimaryBtn from "./Buttons/primaryBtn.astro"
---
<!-- Icon Blocks -->
<div class="max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto">
  <!-- Grid -->
  <div class="grid md:grid-cols-2 gap-12">
    <div class="lg:w-3/4">
      <div class="md:sticky md:top-25">
        <h2 class="text-3xl text-gray-800 font-bold lg:text-5xl dark:text-white">
        Archivistica
      </h2>
      <p class="mt-3 text-gray-800 dark:text-neutral-400">
        Un servizio dedicato alla riorganizzazione e alla valorizzazione degli archivi, 
        con un approccio orientato alla trasformazione digitale dei processi documentali. 
        Supportiamo enti e organizzazioni nella gestione efficace del proprio patrimonio archivistico, 
        garantendo ordine, accessibilità e continuità operativa.
      </p>
      <PrimaryBtn label="Scopri di più" />
      </div>
    </div>
    <!-- End Col -->

    <!-- icon boxes in down below -->
    <div class="space-y-6 lg:space-y-10">
      <!-- Icon Block -->
      <div class="flex gap-x-5 sm:gap-x-8">
        <!-- Icon -->
        <span class="shrink-0 inline-flex justify-center items-center size-11 rounded-full border border-gray-200 bg-white text-gray-800 shadow-2xs mx-auto dark:bg-neutral-900 dark:border-neutral-700 dark:text-neutral-200">
          <svg class="shrink-0 size-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        </span>
        <div class="grow">
          <h3 class="text-base sm:text-xl font-semibold text-gray-800 dark:text-neutral-200">
            Analisi della documentazione per la proposta di scarto
          </h3>
          <p class="mt-1 text-gray-600 dark:text-neutral-400">
            Valutazione accurata dei documenti per individuare ciò che può essere eliminato in sicurezza, 
            nel rispetto delle normative e dei tempi di conservazione.
          </p>
        </div>
      </div>
      <!-- End Icon Block -->

      <!-- Icon Block -->
      <div class="flex gap-x-5 sm:gap-x-8">
        <!-- Icon -->
        <span class="shrink-0 inline-flex justify-center items-center size-11 rounded-full border border-gray-200 bg-white text-gray-800 shadow-2xs mx-auto dark:bg-neutral-900 dark:border-neutral-700 dark:text-neutral-200">
          <svg class="shrink-0 size-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9a2 2 0 0 1-2 2H6l-4 4V4c0-1.1.9-2 2-2h8a2 2 0 0 1 2 2v5Z"/><path d="M18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1"/></svg>
        </span>
        <div class="grow">
          <h3 class="text-base sm:text-lg font-semibold text-gray-800 dark:text-neutral-200">
            Riordino e inventariazione dell’archivio di deposito e storico
          </h3>
          <p class="mt-1 text-gray-600 dark:text-neutral-400">
            Organizzazione strutturata dei materiali archivistici
            e creazione di inventari che ne facilitano consultazione, recupero e gestione.
          </p>
        </div>
      </div>
      <!-- End Icon Block -->

      <!-- Icon Block -->
      <div class="flex gap-x-5 sm:gap-x-8">
        <!-- Icon -->
        <span class="shrink-0 inline-flex justify-center items-center size-11 rounded-full border border-gray-200 bg-white text-gray-800 shadow-2xs mx-auto dark:bg-neutral-900 dark:border-neutral-700 dark:text-neutral-200">
          <svg class="shrink-0 size-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2h0a3.13 3.13 0 0 1 3 3.88Z"/></svg>
        </span>
        <div class="grow">
          <h3 class="text-base sm:text-lg font-semibold text-gray-800 dark:text-neutral-200">
            Censimento della documentazione dell’archivio corrente e di deposito
          </h3>
          <p class="mt-1 text-gray-600 dark:text-neutral-400">
            Mappatura completa dei documenti presenti per 
            ottenere una visione chiara del patrimonio archivistico e delle sue esigenze di gestione.
          </p>
        </div>
      </div>
      <!-- End Icon Block -->

      <!-- Icon Block -->
