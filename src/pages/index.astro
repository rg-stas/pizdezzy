---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import HeroGeneric from "../components/heroGeneric.astro";
import CallToAction from "../components/CallToAction.astro";
import Blog from "../components/Blog.astro";

import HomeContent, { frontmatter } from "../content/home/index.mdx";
import Divider from "../components/divider.astro";
---

<Layout title={frontmatter.title}>
  <main class="space-y-40 mb-40">
    <HeroSection />

    <HeroGeneric
      btns={frontmatter.hero.btns}
      data={{
        title: frontmatter.hero.title,
        desc: frontmatter.hero.desc,
        img: frontmatter.hero.img,
      }}
    />

    <!-- hero dupe for testing -->
    <HeroGeneric 
      btns={frontmatter.hero2.btns}
      data={{
        title: frontmatter.hero2.title,
        desc: frontmatter.hero2.desc,
        img: frontmatter.hero2.img,
        order: frontmatter.hero2.order,
      }}
    />
    <Divider />
    <CallToAction />

    <Blog />
  </main>
</Layout>
